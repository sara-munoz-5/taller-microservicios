---
---

<form id="booking-form" class="booking-form">
  <div class="field">
    <label for="passenger_id">ID del pasajero</label>
    <input
      type="text"
      id="passenger_id"
      name="passenger_id"
      placeholder="Obtenido al registrarte en /pasajeros"
      autocomplete="off"
      required
    />
  </div>

  <div class="field">
    <label for="flight_id">Vuelo</label>
    <select id="flight_id" name="flight_id" required>
      <option value="" selected disabled>Cargando vuelos…</option>
    </select>
  </div>

  <button type="submit">Crear reserva</button>

  <div id="booking-success-box" hidden>
    <p id="booking-success" class="success"></p>
    <p class="hint">
      Usa el <strong>ID</strong> (no el código) en la sección "Mi reserva" para consultarla o cancelarla.
    </p>
  </div>
  <p id="booking-error" class="error" hidden></p>
</form>

<script>
  import {
    createBooking,
    fetchAvailableFlights,
    toErrorMessage,
    type Booking,
    type Flight,
  } from "./booking-api";

  const form = document.querySelector<HTMLFormElement>("#booking-form");
  const flightSelect = document.querySelector<HTMLSelectElement>("#flight_id");
  const successBox = document.querySelector<HTMLDivElement>("#booking-success-box");
  const successMessage = document.querySelector<HTMLParagraphElement>("#booking-success");
  const errorMessage = document.querySelector<HTMLParagraphElement>("#booking-error");

  function renderFlightOptions(flights: Flight[]) {
    if (!flightSelect) return;

    if (flights.length === 0) {
      flightSelect.innerHTML = `<option value="" selected disabled>No hay vuelos con cupos</option>`;
      return;
    }

    flightSelect.innerHTML = flights
      .map(
        (flight) => `
          <option value="${flight.id}">
            ${flight.flight_number}: ${flight.origin} → ${flight.destination} (${flight.available_seats} cupos)
          </option>
        `
      )
      .join("");
  }

  function renderFlightLoadError() {
    if (!flightSelect) return;
    flightSelect.innerHTML = `<option value="" selected disabled>No fue posible cargar los vuelos</option>`;
  }

  async function loadFlightOptions() {
    try {
      renderFlightOptions(await fetchAvailableFlights());
    } catch {
      renderFlightLoadError();
    }
  }

  function hideMessages() {
    successBox!.hidden = true;
    errorMessage!.hidden = true;
  }

  function showSuccess(booking: Booking) {
    successBox!.hidden = false;
    successMessage!.textContent =
      `Reserva creada. Código: ${booking.booking_code} · Estado: ${booking.status} · ID: ${booking.id}`;
  }

  function showError(message: string) {
    errorMessage!.hidden = false;
    errorMessage!.textContent = message;
  }

  function readFormPayload(): { passengerId: string; flightId: string } {
    const formData = new FormData(form!);
    return {
      passengerId: String(formData.get("passenger_id") ?? ""),
      flightId: String(formData.get("flight_id") ?? ""),
    };
  }

  async function handleFormSubmit(event: SubmitEvent) {
    event.preventDefault();
    hideMessages();

    const { passengerId, flightId } = readFormPayload();

    try {
      const booking = await createBooking(passengerId, flightId);
      showSuccess(booking);
      form!.reset();
      await loadFlightOptions();
    } catch (error) {
      showError(toErrorMessage(error, "No fue posible crear la reserva."));
    }
  }

  form?.addEventListener("submit", handleFormSubmit);

  loadFlightOptions();
</script>

<style>
  .booking-form {
    display: grid;
    gap: 1.1rem;
    padding: 1.75rem;
    background: #ffffff;
    border: 1px solid #e5ebf4;
    border-radius: 16px;
    box-shadow: 0 8px 20px rgb(26 42 71 / 6%);
  }

  .field {
    display: grid;
    gap: 0.4rem;
  }

  label {
    color: #152f63;
    font-size: 0.85rem;
    font-weight: 700;
  }

  input,
  select {
    padding: 0.65rem 0.75rem;
    border: 1px solid #e5ebf4;
    border-radius: 8px;
    color: #17202a;
    font-size: 0.95rem;
    font-family: inherit;
    background: #f5f8fc;
  }

  input:focus,
  select:focus {
    outline: 2px solid #ef6c4f;
    outline-offset: 1px;
  }

  button {
    padding: 0.75rem 0.85rem;
    border: 0;
    border-radius: 8px;
    color: white;
    background: #152f63;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
  }

  button:hover {
    background: #0f2249;
  }

  .success {
    padding: 1rem;
    margin: 0;
    border-radius: 10px;
    color: #137333;
    background: #e8f5e9;
  }

  .hint {
    margin: 0.5rem 0 0;
    color: #667085;
    font-size: 0.8rem;
  }

  .error {
    padding: 1rem;
    margin: 0;
    border-radius: 10px;
    color: #b42318;
    background: #fef3f2;
  }
</style>
