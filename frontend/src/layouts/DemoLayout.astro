---
import GlobalNav from '../components/GlobalNav.astro';
const { title, current } = Astro.props;
Astro.response.headers.set('Cache-Control', 'no-store');
---
<!doctype html>
<html lang="es"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>AeroReserva | {title}</title></head>
<body><GlobalNav current={current} tag="Reserva de vuelos" /><main><section class="hero"><p class="eyebrow">VIAJA CON TRANQUILIDAD</p><h1>{title}</h1></section><slot /></main><footer>AeroReserva · Taller de arquitectura de software</footer></body></html>
<style is:global>
:root{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#17202a;background:#f5f8fc}*{box-sizing:border-box}body{margin:0}main{width:min(1100px,88vw);margin:0 auto;min-height:70vh;padding-bottom:4rem}.hero{padding:4rem 0 2rem}h1{color:#152f63;font-size:clamp(2rem,5vw,3.5rem);margin:0}h2{color:#152f63}.eyebrow{color:#ef6c4f;font-size:.75rem;font-weight:800;letter-spacing:.12em}.card{padding:1.75rem;background:white;border:1px solid #e5ebf4;border-radius:16px;box-shadow:0 8px 20px rgb(26 42 71 / 6%);margin-bottom:1.2rem}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.2rem}form,fieldset{display:grid;gap:1rem}fieldset{border:0;padding:0;margin:0;min-width:0}label{display:grid;gap:.4rem;color:#152f63;font-weight:700}input,select{width:100%;padding:.75rem;border:1px solid #e5ebf4;border-radius:8px;font:inherit;background:#f5f8fc}button,.button{padding:.75rem 1rem;border:0;border-radius:8px;background:#152f63;color:white;font:inherit;font-weight:700;cursor:pointer}button:disabled{opacity:.6;cursor:wait}a{color:#152f63}.error{color:#b42318;background:#fef3f2;padding:1rem;border-radius:10px}.success{color:#137333;background:#e8f5e9;padding:1rem;border-radius:10px}.danger{background:#b42318}.muted{color:#667085}.profile{max-width:540px}footer{text-align:center;padding:2rem;background:white;color:#667085}[hidden]{display:none!important}
</style>
