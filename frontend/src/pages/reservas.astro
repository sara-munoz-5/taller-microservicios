---
import DemoLayout from '../layouts/DemoLayout.astro';
import { session } from '../lib/server';
if (!session(Astro.cookies)) return Astro.redirect('/ingresar?next=/reservas');
---
<DemoLayout title="Mis reservas" current="bookings">
<p id="loading" role="status">Consultando tus reservas…</p>
<p id="message" role="status" hidden></p>
<button id="retry" hidden>Volver a consultar</button>
<div id="bookings" class="grid"></div>
<p><a href="/">Buscar otro vuelo</a></p>
<script>
import { api, formatDate, statusLabel, escapeHtml } from '../lib/browser';
const list = document.querySelector<HTMLElement>('#bookings')!;
const loading = document.querySelector<HTMLElement>('#loading')!;
const message = document.querySelector<HTMLElement>('#message')!;
const retry = document.querySelector<HTMLButtonElement>('#retry')!;
async function load() {
 loading.hidden = false; retry.hidden = true; message.hidden = true;
 try {
  const bookings = await api('/api/bookings');
  list.replaceChildren();
  if (!bookings.length) { message.textContent = 'Todavía no tienes reservas. Elige tu próximo vuelo en Inicio.'; message.className = 'muted'; message.hidden = false; }
  for (const booking of bookings) {
   const card = document.createElement('article'); card.className = 'card';
   const flight = booking.flight;
   card.innerHTML = `<h2>${escapeHtml(booking.booking_code)}</h2><p class="status">${statusLabel(booking.status)}</p>` + (flight ? `<p><strong>${escapeHtml(flight.flight_number)} · ${escapeHtml(flight.origin)} → ${escapeHtml(flight.destination)}</strong></p><p>Salida: ${formatDate(flight.departure_at)} (hora Colombia)</p><p>Llegada: ${formatDate(flight.arrival_at)}</p>` : '<p>Los detalles del vuelo ya no están disponibles.</p>');
   if (booking.status === 'BOOKING_STATUS_CONFIRMED') {
    const button = document.createElement('button'); button.textContent = 'Cancelar reserva'; button.className = 'danger';
    const feedback = document.createElement('p'); feedback.setAttribute('role', 'status');
    button.addEventListener('click', async () => {
     button.disabled = true; button.textContent = 'Cancelando…'; feedback.textContent = '';
     try {
      await api('/api/bookings', 'DELETE', { booking_code: booking.booking_code });
      card.querySelector('.status')!.textContent = 'Cancelada'; button.remove(); feedback.textContent = 'Reserva cancelada correctamente.';
     } catch (error) { feedback.textContent = error instanceof Error ? error.message : 'No pudimos cancelar.'; button.disabled = false; button.textContent = 'Cancelar reserva'; }
    });
    card.append(button, feedback);
   }
   list.append(card);
  }
 } catch (error) { message.className = 'error'; message.textContent = error instanceof Error ? error.message : 'No pudimos cargar tus reservas.'; message.hidden = false; retry.hidden = false; }
 finally { loading.hidden = true; }
}
retry.addEventListener('click', load);
load();
</script>
</DemoLayout>
